# Kopye fichye sa a rele l ".env" epi mete vrè valè yo ladan l.
# PA JANM push fichye ".env" (ki gen vrè kle yo) sou GitHub — .gitignore deja pwoteje l.

# Kle API Claude (soti platform.claude.com — tach 0.2)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modèl Claude pou itilize
CLAUDE_MODEL=claude-sonnet-4-6

# Faz 1+ — Google Sheets (ID sheet prensipal la, soti nan URL sheet la)
# GOOGLE_SHEET_ID=
# GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json

# Login senp pou PWA a (tach 1.2)
# APP_ACCESS_CODE=
